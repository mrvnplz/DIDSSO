{
    "manifest_version": 3,
    "name": "DIDSSO-Extension",
    "version": "1.0.0",
    "description": "This extension is necessary for every user to use the OIDC code flow together with DIDs.",

    "action": {
        "default_title": "DIDSSO",
        "default_popup": "frontend/popup.html"
    },
    "background": {
    "scripts": ["background.js"]
    },
    "permissions": [
        "storage",
        "webRequest",
        "webRequestBlocking",
        "tabs"
    ],
    "host_permissions": [
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://127.0.0.1:8765/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "did-sso-firefox-plugin@example.com"
        }
    }
}
